{
  "strategy": "NostalgiaForInfinityX7_5x",
  "add_config_files": [
    "../configs/trading_mode-futures.json",
    "../configs/blacklist-bitget.json",
    "../configs/exampleconfig.json"
  ],
  "exchange": {
    "name": "bitget",
    "key": "",
    "secret": "",
    "password": "",
    "ccxt_config": {
      "options": {
        "defaultType": "swap"
      },
      "httpsProxy": "http://127.0.0.1:9001",
      "rateLimit": 50,
      "timeout": 30000,
      "retries": 5
    },
    "ccxt_async_config": {
      "options": {
        "defaultType": "swap"
      },
      "enableRateLimit": true,
